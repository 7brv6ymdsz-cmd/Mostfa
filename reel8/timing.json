{
"T": 24.298,
"lines": [
{
"i": 0,
"role": "hook",
"text": "أنت تملك اليوم… ما كنت تتمناه يوماً.",
"s": 0.12,
"e": 2.808
},
{
"i": 1,
"role": "list",
"text": "البيت الذي تسكنه، العمل الذي تشكو منه، والناس الذين اعتدت وجودهم.",
"s": 3.158,
"e": 7.607
},
{
"i": 2,
"role": "habit",
"text": "لكن العين تعتاد… فتنسى أن ترى.",
"s": 7.957,
"e": 10.046
},
{
"i": 3,
"role": "not",
"text": "الامتنان ليس أن تتجاهل ما ينقصك.",
"s": 10.496,
"e": 13.014
},
{
"i": 4,
"role": "see",
"text": "الامتنان أن ترى ما لديك… قبل أن تحصي ما ينقصك.",
"s": 13.264,
"e": 16.643
},
{
"i": 5,
"role": "book",
"text": "هذا هو الباب العاشر من كتاب سَكينة.",
"s": 17.043,
"e": 19.546
},
{
"i": 6,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 19.666,
"e": 22.078
},
{
"i": 7,
"role": "share",
"text": "أرسله لشخص تمتن لوجوده.",
"s": 22.328,
"e": 24.298
}
],
