"lines": [
{
"i": 0,
"role": "hook",
"text": "عقلك يعيش في مكانين… لا يمكنك أن تعيش فيهما.",
"s": 0.12,
"e": 3.52
},
{
"i": 1,
"role": "past",
"text": "الماضي… الذي انتهى.",
"s": 3.82,
"e": 5.173
},
{
"i": 2,
"role": "future",
"text": "والمستقبل… الذي لم يأتِ بعد.",
"s": 5.373,
"e": 7.252
},
{
"i": 3,
"role": "now",
"text": "أما الحياة نفسها، فعنوانها واحد: الآن.",
"s": 7.602,
"e": 10.641
},
{
"i": 4,
"role": "try",
"text": "جرّب هذا: اذكر ثلاثة أشياء تراها حولك.",
"s": 11.091,
"e": 14.029
},
{
"i": 5,
"role": "back",
"text": "هل شعرت؟ لقد عدت للتو.",
"s": 15.629,
"e": 17.147
},
{
"i": 6,
"role": "book",
"text": "هذا هو الباب التاسع من كتاب سَكينة.",
"s": 17.497,
"e": 19.951
},
{
"i": 7,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 20.071,
"e": 22.488
},
{
"i": 8,
"role": "save",
"text": "احفظه… وارجع إليه حين يأخذك عقلك بعيداً.",
"s": 22.738,
"e": 25.867
}
],
