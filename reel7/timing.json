"lines": [
{
"i": 0,
"role": "hook",
"text": "عقلك يعيش في مكانين… لا يمكنك أن تعيش فيهما.",
"s": 0.12,
"e": 3.439
},
{
"i": 1,
"role": "past",
"text": "الماضي… الذي انتهى.",
"s": 3.739,
"e": 5.113
},
{
"i": 2,
"role": "future",
"text": "والمستقبل… الذي لم يأتِ بعد.",
"s": 5.313,
"e": 7.212
},
{
"i": 3,
"role": "now",
"text": "أما الحياة نفسها، فعنوانها واحد: الآن.",
"s": 7.562,
"e": 10.528
},
{
"i": 4,
"role": "try",
"text": "جرّب هذا: سمِّ ثلاثة أشياء تراها حولك.",
"s": 10.978,
"e": 13.613
},
{
"i": 5,
"role": "back",
"text": "هل شعرت؟ لقد عدت للتو.",
"s": 15.213,
"e": 16.702
},
{
"i": 6,
"role": "book",
"text": "هذا هو الباب التاسع من كتاب سَكينة.",
"s": 17.052,
"e": 19.436
},
{
"i": 7,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 19.556,
"e": 22.017
},
{
"i": 8,
"role": "save",
"text": "احفظه… وارجع إليه حين يأخذك عقلك بعيداً.",
"s": 22.267,
"e": 25.42
}
],
