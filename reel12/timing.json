{
"T": 30.05,
"lines": [
{
"i": 0,
"role": "hook",
"text": "في يومٍ ما… ستفعل شيئاً للمرة الأخيرة، ولن تعرف أنها الأخيرة.",
"s": 0.12,
"e": 4.445
},
{
"i": 1,
"role": "lasts",
"text": "آخر مرة تحضن فيها أمك. آخر ضحكة مع صديق قديم.",
"s": 4.845,
"e": 8.729
},
{
"i": 2,
"role": "evening",
"text": "آخر مساء عادي… كنت تظنه سيتكرر.",
"s": 9.029,
"e": 11.879
},
{
"i": 3,
"role": "notsad",
"text": "ليس هذا لتحزن.",
"s": 12.429,
"e": 13.611
},
{
"i": 4,
"role": "teacher",
"text": "الموت معلّم صامت… يعلّمنا ما يستحق أن نعيش له.",
"s": 13.911,
"e": 17.543
},
{
"i": 5,
"role": "live",
"text": "فعِش اللحظة القادمة… كأنها تهمّ. لأنها تهمّ.",
"s": 17.943,
"e": 20.892
},
{
"i": 6,
"role": "book",
"text": "هذا هو الباب الحادي عشر من كتاب سَكينة.",
"s": 21.292,
"e": 24.318
},
{
"i": 7,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 24.438,
"e": 26.833
},
{
"i": 8,
"role": "share",
"text": "أرسله لشخص تريد أن تقول له شيئاً… اليوم.",
"s": 27.083,
"e": 30.05
}
],
