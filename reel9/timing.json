{
"T": 26.889,
"lines": [
{
"i": 0,
"role": "hook",
"text": "متى آخر مرة… جلست مع نفسك، بلا هاتف؟",
"s": 0.12,
"e": 2.753
},
{
"i": 1,
"role": "not",
"text": "ليس مع أفكارك عن الآخرين، ولا مع قائمة مهامك… مع نفسك فقط.",
"s": 3.103,
"e": 7.481
},
{
"i": 2,
"role": "fear",
"text": "نحن لا نخاف الوحدة… نخاف ما سنسمعه حين يصمت كل شيء.",
"s": 7.831,
"e": 11.846
},
{
"i": 3,
"role": "diff",
"text": "لكن هناك فرق… بين أن تكون وحيداً، وأن تكون مع نفسك.",
"s": 12.296,
"e": 16.058
},
{
"i": 4,
"role": "try",
"text": "جرّب اليوم خمس دقائق: بلا شيء، فقط أنت.",
"s": 16.408,
"e": 19.02
},
{
"i": 5,
"role": "book",
"text": "هذا هو الباب الثامن من كتاب سَكينة.",
"s": 19.42,
"e": 21.754
},
{
"i": 6,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 21.874,
"e": 24.241
},
{
"i": 7,
"role": "save",
"text": "احفظه… وجرّب الدقائق الخمس الليلة.",
"s": 24.491,
"e": 26.889
}
],
