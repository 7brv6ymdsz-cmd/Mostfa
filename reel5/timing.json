{
"T": 26.016,
"lines": [
{
"i": 0,
"role": "hook",
"text": "في سجن… بابه مفتوح منذ سنوات.",
"s": 0.12,
"e": 2.463
},
{
"i": 1,
"role": "waits",
"text": "والسجين جالس في الداخل… ينتظر من يأتي ليعتذر.",
"s": 2.813,
"e": 6.283
},
{
"i": 2,
"role": "years",
"text": "يمر يوم، ثم سنة… والاعتذار لا يأتي.",
"s": 6.633,
"e": 9.161
},
{
"i": 3,
"role": "ask",
"text": "أتعرف من السجين؟",
"s": 9.661,
"e": 10.684
},
{
"i": 4,
"role": "you",
"text": "أنتَ.",
"s": 11.384,
"e": 11.741
},
{
"i": 5,
"role": "not",
"text": "الصفح ليس أن تقول إن ما حدث كان صواباً.",
"s": 12.541,
"e": 15.296
},
{
"i": 6,
"role": "out",
"text": "الصفح أن تخرج من الباب… لأنك تستحق الهواء.",
"s": 15.496,
"e": 18.332
},
{
"i": 7,
"role": "book",
"text": "هذا هو الباب السادس من كتاب سَكينة.",
"s": 18.732,
"e": 21.312
},
{
"i": 8,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 21.432,
"e": 23.817
},
{
"i": 9,
"role": "share",
"text": "أرسله لشخص ما زال في السجن.",
"s": 24.067,
"e": 26.016
}
],
