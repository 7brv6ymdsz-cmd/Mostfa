{
"T": 24.408,
"lines": [
{
"i": 0,
"role": "hook",
"text": "تبحث عن السلام منذ سنوات… في كل مكان إلا مكاناً واحداً.",
"s": 0.12,
"e": 4.136
},
{
"i": 1,
"role": "search",
"text": "في سفر جديد، في عمل أفضل، في شخص يفهمك أخيراً.",
"s": 4.486,
"e": 8.01
},
{
"i": 2,
"role": "noise",
"text": "وفي كل مرة… يعود الضجيج معك.",
"s": 8.36,
"e": 10.375
},
{
"i": 3,
"role": "not",
"text": "لأن السلام ليس مكاناً تصل إليه.",
"s": 10.825,
"e": 12.952
},
{
"i": 4,
"role": "home",
"text": "السلام هو المكان الذي خرجت منه.",
"s": 13.252,
"e": 15.419
},
{
"i": 5,
"role": "book",
"text": "وكتاب سَكينة… خريطة طريق العودة إليه، في اثني عشر باباً.",
"s": 15.919,
"e": 19.82
},
{
"i": 6,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 19.97,
"e": 22.359
},
{
"i": 7,
"role": "share",
"text": "أرسله لشخص ما زال يبحث.",
"s": 22.609,
"e": 24.408
}
],
