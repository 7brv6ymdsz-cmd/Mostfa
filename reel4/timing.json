{
"T": 25.183,
"lines": [
{
"i": 0,
"role": "hook",
"text": "جرّب أن تقبض على حفنة رمل… بكل قوتك.",
"s": 0.12,
"e": 2.636
},
{
"i": 1,
"role": "leak",
"text": "ماذا يحدث؟ يهرب من بين أصابعك.",
"s": 2.886,
"e": 5.1
},
{
"i": 2,
"role": "love",
"text": "هكذا نفعل مع كل ما نحب: الناس، العمل، الخطط.",
"s": 5.4,
"e": 8.523
},
{
"i": 3,
"role": "grip",
"text": "كلما شددنا أكثر… خسرنا أكثر.",
"s": 8.773,
"e": 10.828
},
{
"i": 4,
"role": "open",
"text": "الآن… افتح يدك.",
"s": 11.278,
"e": 12.405
},
{
"i": 5,
"role": "stays",
"text": "الرمل يبقى… لأنك لم تعد خائفاً أن يضيع.",
"s": 12.955,
"e": 15.697
},
{
"i": 6,
"role": "book",
"text": "هذا هو الباب السابع من كتاب سَكينة: كيف تحب بيد مفتوحة.",
"s": 16.097,
"e": 20.167
},
{
"i": 7,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 20.317,
"e": 22.659
},
{
"i": 8,
"role": "share",
"text": "أرسله لشخص يمسك الدنيا بقوة.",
"s": 22.859,
"e": 25.183
}
],
