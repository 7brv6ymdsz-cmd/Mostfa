{
"T": 28.91,
"lines": [
{
"i": 0,
"role": "hook",
"text": "ثلاث علامات تقول إنك متعب من الداخل، حتى لو لم تشعر.",
"s": 0.12,
"e": 3.757
},
{
"i": 1,
"role": "sign1",
"text": "أولاً: تمسك هاتفك… قبل أن تفتح عينيك.",
"s": 4.017,
"e": 6.545
},
{
"i": 2,
"role": "sign2",
"text": "ثانياً: تعيد محادثات قديمة في رأسك… وتنتصر فيها كل مرة.",
"s": 6.785,
"e": 10.615
},
{
"i": 3,
"role": "sign3",
"text": "ثالثاً: تضحك أمام الجميع… وحين يُغلق الباب، يعود الضجيج.",
"s": 10.855,
"e": 14.907
},
{
"i": 4,
"role": "turn",
"text": "إن وجدت نفسك هنا… فأنت لست ضعيفاً.",
"s": 15.267,
"e": 17.751
},
{
"i": 5,
"role": "turn2",
"text": "أنت فقط نسيت طريق العودة إلى نفسك.",
"s": 17.891,
"e": 20.517
},
{
"i": 6,
"role": "book",
"text": "كتاب سَكينة يعيدك إليها، باباً بعد باب.",
"s": 20.877,
"e": 23.636
},
{
"i": 7,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 23.756,
"e": 26.136
},
{
"i": 8,
"role": "save",
"text": "احفظ هذا الفيديو… ستحتاجه لاحقاً.",
"s": 26.396,
"e": 28.91
}
],
