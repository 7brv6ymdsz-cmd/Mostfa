{
"T": 38.502,
"lines": [
{
"i": 0,
"role": "hook",
"text": "جرّب هذا التمرين لثلاثين ثانية… ولاحظ ما يحدث لجسدك.",
"s": 0.15,
"e": 4.706
},
{
"i": 1,
"role": "relax",
"text": "أرخِ كتفيك، وضع يدك على صدرك.",
"s": 5.156,
"e": 7.72
},
{
"i": 2,
"role": "in",
"text": "خذ نفساً من أنفك…",
"s": 8.27,
"e": 9.787
},
{
"i": 3,
"role": "hold",
"text": "احبس نَفَسك…",
"s": 14.037,
"e": 15.035
},
{
"i": 4,
"role": "out",
"text": "وأخرجه ببطء من فمك…",
"s": 17.235,
"e": 19.384
},
{
"i": 5,
"role": "bridge",
"text": "هذا هو النَّفَس: الجسر الوحيد بين الجسد والروح.",
"s": 25.634,
"e": 29.317
},
{
"i": 6,
"role": "book",
"text": "التمرين من الباب الثالث في كتاب سَكينة.",
"s": 29.617,
"e": 32.609
},
{
"i": 7,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 32.729,
"e": 35.597
},
{
"i": 8,
"role": "save",
"text": "احفظه… وعُد إليه كلما ضاق صدرك.",
"s": 35.847,
"e": 38.502
}
