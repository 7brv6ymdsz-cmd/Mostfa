{
"T": 29.39,
"lines": [
{
"i": 0,
"role": "hook",
"text": "لماذا تتكرر القصة نفسها في حياتك… مع أشخاص مختلفين؟",
"s": 0.12,
"e": 4.162
},
{
"i": 1,
"role": "why",
"text": "لأن الجرح الذي لم يُشفَ… يبحث عن طريقة ليُرى.",
"s": 4.512,
"e": 7.76
},
{
"i": 2,
"role": "loop",
"text": "فيعيد المشهد مرة بعد مرة… حتى تنظر إليه.",
"s": 8.06,
"e": 10.995
},
{
"i": 3,
"role": "not",
"text": "الشفاء ليس أن تنسى ما حدث.",
"s": 11.395,
"e": 13.244
},
{
"i": 4,
"role": "heal",
"text": "الشفاء أن تنظر إلى الألم القديم… دون أن تعيشه من جديد.",
"s": 13.494,
"e": 17.417
},
{
"i": 5,
"role": "gold",
"text": "مثل الفخار الياباني: تُرمَّم شقوقه بالذهب… فتصير أجمل ما فيه.",
"s": 17.767,
"e": 21.922
},
{
"i": 6,
"role": "book",
"text": "هذا هو الباب الخامس من كتاب سَكينة.",
"s": 22.272,
"e": 24.763
},
{
"i": 7,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 24.883,
"e": 27.249
},
{
"i": 8,
"role": "share",
"text": "أرسله لشخص تتكرر قصته.",
"s": 27.499,
"e": 29.39
}
],
