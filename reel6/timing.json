{
"T": 27.467,
"lines": [
{
"i": 0,
"role": "hook",
"text": "لا أحد يغرق بسبب الموج… بل لأنه يصارعه.",
"s": 0.12,
"e": 3.108
},
{
"i": 1,
"role": "fight",
"text": "كلما ضرب بيديه أكثر… تعب أسرع، وغاص أعمق.",
"s": 3.408,
"e": 6.542
},
{
"i": 2,
"role": "float",
"text": "أما من يعرف البحر… فيستلقي على الماء، ويطفو.",
"s": 6.892,
"e": 9.839
},
{
"i": 3,
"role": "shore",
"text": "يتنفس، يهدأ، ثم يختار طريقه إلى الشاطئ.",
"s": 10.239,
"e": 13.215
},
{
"i": 4,
"role": "not",
"text": "القبول… ليس استسلاماً.",
"s": 13.615,
"e": 15.281
},
{
"i": 5,
"role": "accept",
"text": "القبول أن تكف عن مصارعة الموج… دون أن تستسلم للغرق.",
"s": 15.581,
"e": 19.424
},
{
"i": 6,
"role": "book",
"text": "هذا هو الباب الرابع من كتاب سَكينة.",
"s": 19.774,
"e": 22.347
},
{
"i": 7,
"role": "cta",
"text": "المقدمة مجانية، والرابط في البايو.",
"s": 22.467,
"e": 24.873
},
{
"i": 8,
"role": "share",
"text": "أرسله لشخص يصارع موجه الآن.",
"s": 25.123,
"e": 27.467
}
],
